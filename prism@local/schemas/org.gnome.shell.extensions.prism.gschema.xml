<schemalist>
 <schema id="org.gnome.shell.extensions.prism" path="/org/gnome/shell/extensions/prism/">
  <key name="enabled" type="b"><default>true</default></key>
  <key name="simple-profile-version" type="i"><default>0</default></key>
  <key name="material-strength" type="i"><range min="0" max="100"/><default>50</default></key>
  <key name="desktop-profile" type="s">
   <default>'airy'</default>
   <!-- macos is accepted only to migrate the legacy identifier to balanced. -->
   <choices><choice value="subtle"/><choice value="balanced"/><choice value="airy"/><choice value="mist"/><choice value="glass"/><choice value="crystal"/><choice value="custom"/><choice value="macos"/></choices>
   <summary>Coordinated desktop translucency</summary>
   <description>Subtle, Balanced, Airy, Mist, Glass, and Crystal use the same cached rendering with different material densities. Airy is the default. Custom exposes the full strength range.</description>
  </key>
  <key name="auto-comfort" type="b"><default>true</default></key>
  <key name="appearance" type="s"><default>'auto'</default></key>
  <key name="reduce-transparency" type="b"><default>false</default></key>
 </schema>
</schemalist>

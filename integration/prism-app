#!/usr/bin/env python3
"""Launch a native command with automatic GTK4 sidebar detection."""
import argparse
import os
from pathlib import Path
import shutil
import sys

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('app', help='Executable name or path (for example papers, nautilus, or another GTK4 app)')
parser.add_argument('arguments', nargs=argparse.REMAINDER)
args = parser.parse_args()
root = Path(__file__).resolve().parent
library = root / 'libprism-gtk.so'
if not library.is_file():
    parser.error('Adapter is not built. Run make adapter first.')
command = args.app
executable = shutil.which(command)
if Path(command).name in ('flatpak', 'snap'):
    parser.error('Sandbox launchers cannot load this native GTK4 adapter.')
if not executable:
    parser.error(f'{command} was not found. Provide a native executable name or path.')
# Both are single-instance apps: an existing process cannot inherit our environment.
for entry in Path('/proc').iterdir():
    if not entry.name.isdigit():
        continue
    try:
        if entry.stat().st_uid == os.getuid() and (entry / 'exe').resolve() == Path(executable).resolve():
            parser.error(f'{command} is already running. Close it first; an existing process cannot inherit the adapter. No process was stopped.')
    except (PermissionError, FileNotFoundError, ProcessLookupError):
        continue
os.environ['PRISM_GTK_CSS'] = str(root / 'sidebar.css')
os.environ['LD_PRELOAD'] = str(library) + (':' + os.environ['LD_PRELOAD'] if os.environ.get('LD_PRELOAD') else '')
print(f'Prism: launching {command} with automatic GTK4 sidebar detection. Unsupported layouts stay unchanged.', file=sys.stderr, flush=True)
os.execv(executable, [executable, *args.arguments])
